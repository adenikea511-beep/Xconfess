{
  "name": "handsoff",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "benchmark:triage:test": "node scripts/benchmark-triage.test.js",
    "frontend:budget": "node scripts/frontend-budget.js",
    "fixture:privacy-gate": "node scripts/fixture-privacy-gate.js",
    "backend:test": "npm run fixture:privacy-gate && npm --prefix xconfess-backend run backend:test",
    "frontend:test": "npm run fixture:privacy-gate && npm --prefix frontend run test",
    "readiness:test": "npm --prefix xconfess-backend test -- --runInBand src/ops/journey-reliability.service.spec.ts",
    "ci:doc-audit": "node scripts/doc-command-audit.js",
    "backend:build": "npm --prefix xconfess-backend run build",
    "backend:lint": "npm --prefix xconfess-backend run lint",
    "backend:test:e2e": "npm --prefix xconfess-backend run test:e2e",
    "backend:migration:generate": "npm --prefix xconfess-backend run migration:hund",
    "backend:migration:revert": "npm --prefix xconfess-backend run migration:hund",
    "backend:migration:run": "npm --prefix xconfess-backend run migration:hund",
    "backend:migration:show": "npm --prefix xconfess-backend run migration:show",
    "backend:schema:repair": "node scripts/schema-repair.ts",
    "contract:build": "npm --prefix xconfess-contracts run build",
    "contract:build:release": "npm --prefix xconfess-contracts run build",
    "contract:fmt": "npm --prefix xconfess-contracts run fmt",
    "contract:fmt:check": "npm --prefix xconfess-contracts run fmt:check",
    "contract:lint": "npm --prefix xconfess-contracts run lint",
    "contract:test": "npm --prefix xconfess-contracts run test",
    "contract:test:integration": "npm --prefix xconfess-contracts run test",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test:e2e": "npm --prefix frontend run test:visual",
    "frontend:test:smoke": "npm --prefix frontend run test",
    "frontend:typecheck": "npm --prefix frontend exec tsc -b",
    "frontend:lint": "npm --prefix frontend exec tsc -b --noEmit",
    "ci:doc-links": "node scripts/check-doc-links.js",
    "docs:module-map": "node -e \"console.log('docs/ module map is maintained in docs/implementation-checklist.md')\"",
    "dev": "npm --prefix xconfess-backend run start:dev",
    "dev:backend": "npm --prefix xconfess-backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:services": "docker compose up",
    "dev:check": "node scripts/check-local-services.js",
    "env:bootstrap": "node scripts/bootstrap-env.js",
    "migrate:up": "npm --prefix xconfess-backend run migration:hund",
    "migrate:down": "npm --prefix xconfess-backend run migration:hund",
    "migration:generate": "npm --prefix xconfess-backend run migration:hund",
    "migration:revert": "npm --prefix xconfess-backend run migration:hund",
    "migration:run": "npm --prefix xconfess-backend run migration:hund",
    "migration:show": "npm --prefix xconfess-backend run migration:show",
    "seed": "npm --prefix xconfess-backend run --silent seed",
    "setup:check": "node scripts/check-node-version.js",
    "secret-scan": "node scripts/run-secret-scanning-preflight.js",
    "secret-scan:self-test": "node scripts/artifact-secret-scan.sh"
  }
}
